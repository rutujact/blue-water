# https://jasonstitt.com/gitignore-whitelisting-patterns
# Ignore everything
*
# But descend into directories
!*/
# You can be specific with these rules
!code/*.R
!R/*.R
# Workflow
!crop-waterbudget_Workflow.html
# Input data
!data/processed/et0.week.imd.csv
!data/processed/crop.parameters.csv
!data/processed/Kc_curve_parameters_by_crop_rotation.csv
!data/processed/soil.parameters.csv
!data/raw/*.csv
# Output data
!output/water_budgets/water.budget.annual.csv
!output/water_budgets/water.budget.annual.climatology.csv
!output/water_budgets/water.budget.monthly.climatology.csv
!output/water_budgets/water.budget.daily.1970.csv
!output/water_budgets/water.budget.annual.climatology_mean_wide.csv
# Ouput figures
!figures/water_budgets/annual_climatology_water_budget_mean.jpg
!figures/water_budgets/annual_climatology_water_budget_median.jpg
!figures/water_budgets/annual_climatology_npwr_mean.jpg
!figures/water_budgets/monthly_climatology_water_budget_median.jpg
!figures/water_budgets/monthly_climatology_npwr_median.jpg
!figures/crop_kc_curves/Segmented_Crop_Coefficient_Curves.pdf
!figures/crop_kc_curves/get_kc_output_by_crop.system.jpg
# Recursively allow files under subtree
!.gitignore
DESCRIPTION
!*.Rmd
!*.Rproj
!preamble.tex
